---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | LavaCore" description="The page you're looking for doesn't exist.">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-lg">
      <p class="text-9xl font-display text-transparent bg-clip-text bg-gradient-to-r from-ember to-magma mb-4">404</p>
      <h1 class="text-4xl font-display text-paper mb-4">LOST IN THE LAVA</h1>
      <p class="text-lg text-ash font-body mb-10 leading-relaxed">
        The page you're looking for has been consumed by the lava lane.
        Head back home and try a different path.
      </p>
      <a
        href="/"
        class="px-10 py-4 rounded-lg bg-gradient-to-r from-ember to-crimson text-white font-ui font-bold uppercase tracking-wider text-lg hover:scale-105 hover:shadow-[0_0_40px_rgba(204,51,0,0.7)] transition-all inline-flex items-center justify-center gap-3"
      >
        ← Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
