---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy — LavaCore';
const description = 'Privacy policy for the LavaCore app and related sites.';
---

<BaseLayout title={title} description={description}>
  <header class="border-b border-white/10 bg-[#0B0705]/90 px-5 py-6">
    <nav class="wrap flex items-center justify-between text-sm font-bold text-ash">
      <a href="/" class="text-paper hover:text-ember">← LavaCore</a>
      <a href="/terms" class="hover:text-ember">Terms</a>
    </nav>
  </header>

  <main class="wrap section max-w-3xl text-paper">
    <h1 class="text-4xl font-black">Privacy Policy</h1>
    <p class="mt-2 text-ash">Last updated: April 2026</p>

    <p class="mt-8 leading-8 text-ash">
      <strong class="text-paper">LavaCore</strong> (“we”) respects your privacy. This policy
      describes how we handle information when you use the LavaCore apps, the site at
      <span class="text-paper">lavacore.app</span>, and the hosted web app at
      <span class="text-paper">web.lavacore.app</span>.
    </p>

    <h2 class="mt-10 text-2xl font-black text-paper">Bluetooth and device data</h2>
    <p class="mt-3 leading-8 text-ash">
      Game control and telemetry are exchanged with your LED hardware over BLE. We do not
      need access to your contacts or photos for core gameplay. Optional cloud features,
      if enabled, are governed by their own notices in the app.
    </p>

    <h2 class="mt-10 text-2xl font-black text-paper">Analytics and hosting</h2>
    <p class="mt-3 leading-8 text-ash">
      Static marketing pages may be served via Firebase Hosting. The Flutter app may use
      third-party SDKs you configure in your build (for example analytics or crash reporting).
      Review their policies for details beyond this summary.
    </p>

    <h2 class="mt-10 text-2xl font-black text-paper">Contact</h2>
    <p class="mt-3 leading-8 text-ash">
      Questions:
      <a class="text-ember underline" href="mailto:support@lavacore.app">support@lavacore.app</a>
    </p>
  </main>

  <footer class="border-t border-white/10 px-5 py-8 text-center text-sm text-ash">
    <a href="/" class="hover:text-ember">Home</a>
    ·
    <a href="/terms" class="hover:text-ember">Terms</a>
  </footer>
</BaseLayout>
