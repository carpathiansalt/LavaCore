---
import BaseLayout from '../layouts/BaseLayout.astro';

const rules = [
  ['Enemy', 'position 0-1000, direction 0/1, speed 0+, wobble 0 for straight movement.'],
  ['Spawner', 'position 0-1000, rate in ms, speed, direction, optional delayed activation.'],
  ['Lava', 'start/end points, on/off timing, offset, grow, and flow.'],
  ['Conveyor', 'start/end points and signed speed. Keep speed below player max speed.'],
  ['Boss', 'one boss level; it owns its own spawn behavior.'],
];
---

<BaseLayout title="LavaCore Level Builder">
  <header class="border-b border-white/10 bg-[#0B0705]">
    <nav class="wrap flex h-16 items-center justify-between">
      <a href="/" class="font-black">LavaCore</a>
      <a class="btn btn-secondary" href="/">Back to site</a>
    </nav>
  </header>

  <main>
    <section class="section pb-10">
      <div class="wrap">
        <p class="eyebrow">Docs-only v1</p>
        <h1 class="mt-3 max-w-4xl text-5xl font-black leading-tight">Level Builder</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-ash">
          TWANG levels are built on a 1000-unit virtual line, then mapped to
          however many LEDs are installed. This builder exports snippets for
          firmware `loadLevel()` or a markdown recipe for planning.
        </p>
      </div>
    </section>

    <section class="px-5 pb-16">
      <div class="wrap grid gap-6 lg:grid-cols-[360px_1fr]">
        <aside class="card p-5">
          <h2 class="text-xl font-black">Add element</h2>
          <label class="mt-5 block text-sm font-bold text-ash" for="type">Type</label>
          <select id="type" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3">
            <option value="enemy">Enemy</option>
            <option value="spawner">Spawner</option>
            <option value="lava">Lava</option>
            <option value="conveyor">Conveyor</option>
            <option value="boss">Boss</option>
          </select>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <label class="text-sm font-bold text-ash">Position
              <input id="pos" type="number" min="0" max="1000" value="350" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3" />
            </label>
            <label class="text-sm font-bold text-ash">End
              <input id="end" type="number" min="0" max="1000" value="450" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3" />
            </label>
            <label class="text-sm font-bold text-ash">Speed
              <input id="speed" type="number" min="-9" max="9" value="2" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3" />
            </label>
            <label class="text-sm font-bold text-ash">Direction
              <select id="dir" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3">
                <option value="0">Toward start</option>
                <option value="1">Toward exit</option>
              </select>
            </label>
            <label class="text-sm font-bold text-ash">Rate ms
              <input id="rate" type="number" min="250" max="10000" value="3000" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3" />
            </label>
            <label class="text-sm font-bold text-ash">Wobble
              <input id="wobble" type="number" min="0" max="500" value="0" class="mt-2 w-full rounded-lg border border-white/10 bg-[#0B0705] p-3" />
            </label>
          </div>

          <button id="add" class="btn btn-primary mt-5 w-full" type="button">Add to line</button>
          <button id="clear" class="btn btn-secondary mt-3 w-full" type="button">Clear</button>
        </aside>

        <div class="space-y-6">
          <section class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-xl font-black">1000-unit line</h2>
              <div class="flex gap-2 text-xs font-bold text-ash">
                <span>0</span>
                <span>500</span>
                <span>1000</span>
              </div>
            </div>
            <div id="line" class="relative mt-6 h-20 rounded-lg border border-white/10 bg-[#090605]"></div>
            <p id="validation" class="mt-4 min-h-6 text-sm font-bold text-magma"></p>
          </section>

          <section class="card p-5">
            <h2 class="text-xl font-black">Elements</h2>
            <ul id="elements" class="mt-4 grid gap-2 text-sm text-ash"></ul>
          </section>

          <section class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-xl font-black">Export</h2>
              <div class="flex gap-2">
                <button id="cpp" class="btn btn-secondary" type="button">C++</button>
                <button id="md" class="btn btn-secondary" type="button">Markdown</button>
              </div>
            </div>
            <textarea id="output" readonly rows="12" class="mt-4 w-full rounded-lg border border-white/10 bg-[#080504] p-4 font-mono text-sm leading-6 text-[#F5EDE5]"></textarea>
          </section>
        </div>
      </div>
    </section>

    <section class="section bg-[#0F0A08]">
      <div class="wrap">
        <p class="eyebrow">Original TWANG rules</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
          {rules.map(([title, body]) => (
            <article class="card p-5">
              <h3 class="font-black">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-ash">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const state = [];
    const $ = (id) => document.getElementById(id);
    const line = $('line');
    const elements = $('elements');
    const output = $('output');
    const validation = $('validation');

    const clamp = (n, min, max) => Math.min(max, Math.max(min, Number(n) || 0));
    const pct = (n) => `${clamp(n, 0, 1000) / 10}%`;

    function readElement() {
      const type = $('type').value;
      const item = {
        type,
        pos: clamp($('pos').value, 0, 1000),
        end: clamp($('end').value, 0, 1000),
        speed: Number($('speed').value) || 0,
        dir: Number($('dir').value) || 0,
        rate: clamp($('rate').value, 250, 10000),
        wobble: clamp($('wobble').value, 0, 500),
      };
      if (item.type === 'boss') item.pos = 900;
      if ((item.type === 'lava' || item.type === 'conveyor') && item.end <= item.pos) {
        throw new Error('End must be greater than position for lava and conveyors.');
      }
      return item;
    }

    function render() {
      line.innerHTML = '<div class="absolute left-0 right-0 top-1/2 h-2 -translate-y-1/2 rounded-full bg-white/10"></div>';
      elements.innerHTML = '';
      state.forEach((item, index) => {
        const marker = document.createElement('button');
        marker.type = 'button';
        marker.title = `${item.type} ${index + 1}`;
        marker.className = 'absolute top-1/2 h-8 -translate-y-1/2 rounded-md border border-white/40 text-[10px] font-black text-black';
        marker.style.left = pct(item.pos);
        marker.style.width = item.type === 'lava' || item.type === 'conveyor'
          ? `calc(${pct(item.end - item.pos)} + 10px)`
          : '18px';
        marker.style.background = {
          enemy: '#FF3B3B',
          spawner: '#FFD24F',
          lava: '#FF5A1F',
          conveyor: '#4FB8FF',
          boss: '#FF4FB8',
        }[item.type];
        marker.textContent = index + 1;
        marker.addEventListener('click', () => {
          state.splice(index, 1);
          render();
        });
        line.appendChild(marker);

        const li = document.createElement('li');
        li.className = 'rounded-md border border-white/10 bg-white/5 p-3';
        li.textContent = describe(item, index);
        elements.appendChild(li);
      });
      output.value = exportCpp();
    }

    function describe(item, index) {
      if (item.type === 'enemy') return `${index + 1}. Enemy at ${item.pos}, dir ${item.dir}, speed ${item.speed}, wobble ${item.wobble}`;
      if (item.type === 'spawner') return `${index + 1}. Spawner at ${item.pos}, every ${item.rate} ms, speed ${item.speed}, dir ${item.dir}`;
      if (item.type === 'lava') return `${index + 1}. Lava ${item.pos}-${item.end}, 2000 ms on/off`;
      if (item.type === 'conveyor') return `${index + 1}. Conveyor ${item.pos}-${item.end}, speed ${item.speed}`;
      return `${index + 1}. Boss level`;
    }

    function exportCpp() {
      if (state.length === 0) return '// Add elements to export a level snippet.';
      return state.map((item) => {
        if (item.type === 'enemy') return `spawnEnemy(${item.pos}, ${item.dir}, ${Math.abs(item.speed)}, ${item.wobble}, playerSideRef);`;
        if (item.type === 'spawner') return `spawnSpawner(0, ${item.pos}, ${item.rate}, ${Math.abs(item.speed)}, ${item.dir}, 0);`;
        if (item.type === 'lava') return `spawnLava(${item.pos}, ${item.end}, 2000, 2000, 0, Lava::OFF, 0, 0);`;
        if (item.type === 'conveyor') return `spawnConveyor(${item.pos}, ${item.end}, ${item.speed});`;
        return 'spawnBoss();';
      }).join('\n');
    }

    function exportMarkdown() {
      if (state.length === 0) return 'No level elements yet.';
      return state.map(describe).join('\n');
    }

    $('add').addEventListener('click', () => {
      try {
        state.push(readElement());
        validation.textContent = '';
        render();
      } catch (error) {
        validation.textContent = error.message;
      }
    });
    $('clear').addEventListener('click', () => {
      state.splice(0, state.length);
      render();
    });
    $('cpp').addEventListener('click', () => {
      output.value = exportCpp();
    });
    $('md').addEventListener('click', () => {
      output.value = exportMarkdown();
    });
    render();
  </script>
</BaseLayout>
